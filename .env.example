# Copy to `.env` and fill in real values locally. Never commit `.env`.
# Quote values that contain shell metacharacters such as &, #, or spaces.

# --- Runtime ---

APP_ENV=local
LOG_PATH=logs/vocabulary.log

SYNC_ENABLED=true
NOTIFICATIONS_ENABLED=true

# --- MongoDB ---
# Secret: connection string may include username and password.
# When set, vocabulary items go to `vocabulary_items` and PocketBook sessions to
# `pocketbook_sessions`. Leave empty to use in-memory vocabulary storage.
# Example: mongodb+srv://user:password@cluster0.example.test/vocabulary_bot?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=vocabulary_bot

# --- Telegram ---
# Secret: bot token from @BotFather. Format: <bot_id>:<token>
# Example: 1234567890:FAKE_TELEGRAM_BOT_TOKEN_FOR_EXAMPLE_ONLY
TELEGRAM_BOT_TOKEN=

# Required when polling is enabled. Numeric Telegram user ID allowed to run commands.
# Service notifications, including startup messages, are always sent here.
# Get it from @userinfobot or from a bot update payload.
# Example: 123456789
TELEGRAM_ALLOWED_USER_ID=

# Delivery target for review push cards in a channel or group.
# /push sends the review reminder with buttons here; command status replies stay in the command chat.
# Service notifications always use TELEGRAM_ALLOWED_USER_ID.
# Example: -1001234567890
TELEGRAM_TARGET_CHAT_ID=

# Start Telegram long polling after startup sync when token is configured.
TELEGRAM_POLLING_ENABLED=true

# Optional API override for tests or self-hosted Bot API proxy. Leave empty for api.telegram.org.
TELEGRAM_API_BASE_URL=

# Hide /push translation blocks behind a Telegram spoiler until tapped.
TELEGRAM_REVIEW_SPOILER_TRANSLATIONS=true

# --- Scheduler ---
# Standard 5-field cron: minute hour day month weekday.
# Leave a cron empty to disable that job. Times use SCHEDULE_TIMEZONE or local time.
# Auto sync: daily at 09:00.
SCHEDULE_TIMEZONE=
AUTO_SYNC_CRON='0 9 * * *'
# Auto push: every 2 hours from 12:00 through 20:00 (12, 14, 16, 18, 20).
AUTO_PUSH_CRON='0 12-21/2 * * *'

# --- PocketBook Cloud ---

POCKETBOOK_SYNC_ENABLED=true

# Account email used for shop discovery and password bootstrap.
# Alias: POCKETBOOK_LOGIN
# Example: reader@example.test
POCKETBOOK_EMAIL=

# Secret: account password. Used only for bootstrap when no valid refresh token is stored.
# Do not persist this value in MongoDB or logs.
POCKETBOOK_PASSWORD=

# Secret (optional override): refresh/session token from a previous bootstrap.
# Normal setup should leave this empty and let the app capture the token automatically
# into MongoDB `pocketbook_sessions` or the fallback file store.
POCKETBOOK_REFRESH_TOKEN=

# Optional shop/store name when the account exposes multiple shops.
POCKETBOOK_SHOP_NAME=

# Fallback secret store path when MongoDB is not configured.
# Default: ~/.config/vocabulary-bot/pocketbook-session.json
# The file is written with owner-only permissions and contains access/refresh tokens.
POCKETBOOK_TOKEN_PATH=

# Optional unofficial API base URL override for tests or discovery.
POCKETBOOK_API_BASE_URL=

# Download PocketBook books into a local cache during sync, extract book-sentence
# context for dictionary word notes (pbr:/word + offs), and keep up to
# POCKETBOOK_BOOK_CACHE_MAX cached titles by lastUsedAt.
# Cache path defaults to $TMPDIR/vocabulary-bot/books; override only when needed.
POCKETBOOK_BOOK_CONTEXT_ENABLED=true
POCKETBOOK_BOOK_CACHE_DIR=
POCKETBOOK_BOOK_CACHE_MAX=2

# --- Google Sheets ---
# Secret: full Google service account JSON key, or base64-encoded JSON.
# Create in Google Cloud Console, then share the spreadsheet with the service account email.
# Example value shape: {"type":"service_account","project_id":"example",...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<spreadsheet_id>/edit
# Alias: GOOGLE_SHEET_ID
GOOGLE_SPREADSHEET_ID=

GOOGLE_SHEET_SYNC_ENABLED=true
GOOGLE_SHEET_NAME=Vocabulary
GOOGLE_SHEET_RANGE=Vocabulary!A:Z
